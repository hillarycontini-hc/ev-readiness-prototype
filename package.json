{
  "name": "ev-readiness-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Is an EV right for me? A ZIP-based EV readiness decision tool built on public data.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data:fetch": "node scripts/data/fetch-raw.mjs",
    "data:build": "node scripts/data/build-data.mjs && node scripts/data/build-vehicles.mjs",
    "data": "npm run data:fetch && npm run data:build",
    "vendor": "node scripts/vendor.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:a11y": "node tests/a11y/run-axe.mjs",
    "test:e2e": "node --test tests/e2e/*.e2e.mjs",
    "data:vehicles": "node scripts/data/build-vehicles.mjs",
    "data:nhtsa": "node scripts/data/fetch-nhtsa.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "fflate": "0.8.3",
    "playwright": "1.64.1",
    "posthog-js": "1.438.12"
  }
}
