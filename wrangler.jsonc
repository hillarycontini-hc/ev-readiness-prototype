// Cloudflare Workers deploy. Static files come from site/ (site/_headers sets their
// security headers). The Worker script runs only for /api/* (place search proxy).
// The GEOAPIFY_KEY secret is set in the Cloudflare dashboard, never in this file.
{
  "name": "ev-readiness-prototype",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Per-visitor limit on place searches: 30 per minute per Cloudflare location.
  "ratelimits": [
    { "name": "SEARCH_LIMITER", "namespace_id": "4317", "simple": { "limit": 30, "period": 60 } }
  ],
  // No request logs: searched addresses are never recorded.
  "observability": { "enabled": false },
  // Pull-request branches deploy with `wrangler preview`, which needs this block (it can be empty).
  "previews": {}
}
