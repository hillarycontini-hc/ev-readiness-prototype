// Cloudflare Workers deploy. Static files come from site/ (site/_headers sets their
// security headers). The Worker script runs only for /api/* (place search and routing proxy).
// The GEOAPIFY_KEY secret is set in the Cloudflare dashboard, never in this file.
{
  "name": "ev-readiness-prototype",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Per-visitor limits (hashed IP, per Cloudflare location): 30 place searches a minute,
  // and 6 routes a minute, since a route costs more and a visitor plans a trip at a time.
  // ROUTE_GLOBAL_LIMITER is one shared key: at most 30 routes a minute per location for
  // everyone, so scripted callers can't drain the free Geoapify quota that search also uses.
  // The Worker refuses search or routing if its limiter is missing.
  "ratelimits": [
    { "name": "SEARCH_LIMITER", "namespace_id": "4317", "simple": { "limit": 30, "period": 60 } },
    { "name": "ROUTE_LIMITER", "namespace_id": "4318", "simple": { "limit": 6, "period": 60 } },
    { "name": "ROUTE_GLOBAL_LIMITER", "namespace_id": "4319", "simple": { "limit": 30, "period": 60 } }
  ],
  // No request logs: searched addresses and routes are never recorded.
  "observability": { "enabled": false },
  // Pull-request branches deploy with `wrangler preview`, which needs this block (it can be empty).
  "previews": {}
}
